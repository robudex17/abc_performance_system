<script setup>
import SidebarMenuItem from './SidebarMenuItem.vue'
import { ref, computed, onMounted } from 'vue'
import { useRouter, useRoute } from 'vue-router'

// Simulate current user (replace with your actual user object or store)
const currentUser = ref({ role: 'user' }) // or 'admin', 'agent', etc.

const submenuStates = ref({})
const activeMenu = ref(null)

// your original menuItems here (with roles)
const menuItems = ref([
  {
    name: "Dashboard",
    icon: ['fas', 'tachometer-alt'],
    route: "/dashboard",
    roles: ["admin", "user"]
  },
 { 
              name: 'Performance Evaluation', 
              route: null, 
